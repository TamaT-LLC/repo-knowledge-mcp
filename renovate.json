{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm",
    ":configMigration",
    ":enableVulnerabilityAlerts",
    ":maintainLockFilesWeekly"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 6am on Monday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "automerge": false,
  "labels": ["dependencies"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": false,
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": null,
    "addLabels": ["security"]
  },
  "packageRules": [
    {
      "description": "Group non-major development dependency updates",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major development dependencies"
    },
    {
      "description": "Group GitHub Actions updates while retaining digest pinning",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Require Dependency Dashboard approval for major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the npm CLI used by the release workflow",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/release\\.yml$/"],
      "matchStrings": [
        "RELEASE_NPM_VERSION:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "npm",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ]
}
