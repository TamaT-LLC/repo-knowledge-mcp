{
  "name": "repo-knowledge-mcp",
  "version": "0.1.0",
  "description": "Deterministic primitives for the repo knowledge MCP write path",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "format": "prettier --write '.github/**/*.yml' 'src/**/*.ts' 'test/**/*.ts' '*.json' '*.mjs'",
    "format:check": "prettier --check '.github/**/*.yml' 'src/**/*.ts' 'test/**/*.ts' '*.json' '*.mjs'",
    "lint": "eslint src test --max-warnings=0",
    "test": "npm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
