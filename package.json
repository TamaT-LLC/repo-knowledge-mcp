{
  "name": "@tamat-llc/repo-knowledge-mcp",
  "version": "0.3.0",
  "description": "Local-first MCP server that turns pull-request review knowledge into reusable repository rules",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "repo-knowledge": "./dist/bin.js",
    "repo-knowledge-mcp": "./dist/bin.js"
  },
  "files": [
    "dist/",
    "prompts/",
    "README.md",
    "SECURITY.md"
  ],
  "mcpName": "io.github.tamat-llc/repo-knowledge",
  "mcpProtocolVersions": [
    "2025-11-25",
    "2026-07-28"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "import": "./dist/experimental.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pull-request",
    "code-review",
    "knowledge-base"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TamaT-LLC/repo-knowledge-mcp.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/TamaT-LLC/repo-knowledge-mcp/issues"
  },
  "homepage": "https://github.com/TamaT-LLC/repo-knowledge-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "execa": "^10.0.1",
    "picomatch": "^4.0.5",
    "pino": "^10.3.1",
    "ulid": "^3.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "bootstrap:pack": "node scripts/build-bootstrap-package.mjs",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run docs:check && npm run install-scripts:check && npm run lint && npm run typecheck && npm run golden:corpus:check && npm run test:release-tools && npm run test:coverage-thresholds && npm run test:coverage",
    "docs:check": "node check-markdown-links.mjs",
    "format": "biome format --write . && prettier --write '.github/**/*.yml'",
    "format:check": "biome format . && prettier --check '.github/**/*.yml'",
    "golden": "npm run build && node dist/golden-cli.js test/fixtures/golden/m1-golden.json && node dist/golden-cli.js test/fixtures/golden/m2-outcome-ranking-golden.json && node dist/golden-cli.js test/fixtures/golden/m2-provider-baseline.json --thresholds test/fixtures/golden/m2-quality-thresholds.json",
    "golden:baseline:replay": "npm run build && node dist/golden-baseline-cli.js --corpus test/fixtures/golden/m2-anonymized-corpus.json --replay test/fixtures/golden/m2-recorded-predictions.json --out test/fixtures/golden/m2-provider-baseline.json",
    "golden:corpus:check": "node scripts/generate-m2-baseline-corpus.mjs --check",
    "golden:corpus:generate": "node scripts/generate-m2-baseline-corpus.mjs",
    "install-scripts:check": "node scripts/install-scripts-gate.mjs",
    "lint": "biome lint --error-on-warnings .",
    "package:gate": "node scripts/package-artifact-gate.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "pilot:daily": "npm run build && node dist/pilot-daily-record-cli.js",
    "prepack": "npm run --silent build",
    "quality:gate": "npm run build && node dist/quality-gate-cli.js",
    "registry:smoke": "node scripts/registry-smoke.mjs",
    "release:verify": "node scripts/release-gate.mjs",
    "smoke:m1": "npm run build && node dist/m1-smoke-cli.js",
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "test:coverage-thresholds": "node --test scripts/coverage-gate-tests.mjs",
    "test:release-tools": "node --test scripts/release-tools-tests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "fsevents": false
  }
}
